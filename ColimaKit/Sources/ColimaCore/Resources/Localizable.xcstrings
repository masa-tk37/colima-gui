    },
    "CPU can be at most %lld on this Mac." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac では CPU は最大 %lld までです。"
          }
        }
      }
    },
    "Changing the VM type from %@ to %@ deletes the VM and recreates it. All containers, images, and volumes in the VM are lost and cannot be recovered. Colima settings other than the VM type, such as mounts and networks, return to their defaults." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the VM type from %1$@ to %2$@ deletes the VM and recreates it. All containers, images, and volumes in the VM are lost and cannot be recovered. Colima settings other than the VM type, such as mounts and networks, return to their defaults."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM タイプを %1$@ から %2$@ に変更するため、VM を削除して作り直します。VM 内のコンテナ・イメージ・ボリュームはすべて失われ、元に戻せません。マウントやネットワークなど、VM タイプ以外の Colima の設定は既定値に戻ります。"
          }
        }
      }
    },
    "Choose a distribution." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディストリビューションを選んでください。"
